# Copie para .env e preencha:  cp .env.exemplo .env
# (o deploy/instalar.sh faz isso por você)

# Seu domínio, sem https:// (o DNS tipo A precisa apontar para o IP do servidor)
DOMINIO=ponto.suaempresa.com.br
# E-mail para o certificado HTTPS (Let's Encrypt avisa por ele se algo der errado)
EMAIL_SSL=voce@suaempresa.com.br

# Chave secreta dos logins: gere com  openssl rand -hex 32
DIXI_SEGREDO=

# 1 = qualquer pessoa pode criar uma empresa (modo SaaS). Vazio = só a primeira empresa.
DIXI_CADASTRO_ABERTO=

# Validade jurídica (Portaria 671) — preencha quando tiver:
# Número de registro do software no INPI (17 dígitos)
DIXI_REGISTRO_INPI=
# Certificado A1 ICP-Brasil: coloque o .pfx na pasta ./certificado
# DIXI_CERT_PFX=/app/certificado/certificado.pfx
# DIXI_CERT_SENHA=
# Dados do desenvolvedor do software (aparecem no AFD/AEJ)
DIXI_CNPJ_DESENV=
DIXI_EMAIL_DESENV=

# Quantos backups diários manter
DIXI_BACKUP_DIAS=30
